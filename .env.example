# Django Settings
SECRET_KEY=django-insecure-change-impact-analyzer-dev-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database (PostgreSQL default for production/docker, defaults to local SQLite if omitted)
DATABASE_URL=postgres://impact_user:impact_password@localhost:5432/impact_analyzer_db

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# JWT Settings
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limits
MAX_FILE_SIZE_BYTES=5242880
MAX_ARCHIVE_SIZE_BYTES=104857600
MAX_TOTAL_FILES=5000
GIT_TIMEOUT_SECONDS=120
TEST_TIMEOUT_SECONDS=120
MAX_GRAPH_DEPTH=15
